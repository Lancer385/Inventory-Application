<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <div>
        <% if (locals.games){ %>
        <% for (const {gameID, gameName, genres} of games){ %>
            <%- include("partials/game", {
                id: gameID,
                name: gameName,
                genres: genres
            })  %>
        <% }} %>
    </div>
</body>
</html>