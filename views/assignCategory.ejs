<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <% if (Object.keys(categories).length !== 0) { %>
    <form action="/<%= gameName %>/<%= gameId %>/assignCategories" method="post">
        <% for (const [name, arr] of Object.entries(categories)) { %>
        <label for="<%= name %>"> <%= name %> : </label>
            <input type="checkbox" id="<%= name %>" class="category">
                <fieldset id="<%= name %>Input" disabled>
                    <%- include("partials/options",  {name: name, category: arr}) %>
                </fieldset>
        <% } %>
        <button type="submit">Add</button>
    </form>
        <%- include("partials/toggleSelect") %>
    <% } else {  %>
        <h1>looks like there's nothing to add</h1>
    <% } %>
</body> 
</html>