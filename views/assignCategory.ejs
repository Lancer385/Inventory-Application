<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/style.css">
    <title><%= title  %></title>
</head>
<body>
    <%- include("partials/header")  %>
    <% if (Object.keys(categories).length !== 0) { %>
    <div class="formContainer">
        <form action="/games/<%= gameName %>/<%= gameID %>/assignCategories" method="post">
            <% for (const [name, arr] of Object.entries(categories)) { %>
            <label><%= name %></label>
                <input type="checkbox" id="<%= name %>" class="category">
                    <fieldset id="<%= name %>Input" disabled>
                        <%- include("partials/options",  {name: name, category: arr}) %>
                    </fieldset>
            <% } %>
            <button type="submit"><span>Assign</span></button>
        </form>
           <script src="/scripts/toggleSelect.js"></script>
        <% } else {  %>
            <h1>looks like there's nothing to add</h1>
        <% } %>
    </div>
    <%- include("partials/footer")  %>
</body> 
</html>