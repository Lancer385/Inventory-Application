<div class="gameContainer" >
    <div class="game">
        <h3><%= gameName %></h3>
    </div>
    <div class="relatedCategory">
            <% for (const [name, value] of Object.entries(categories)){ %>
                <% if (value.length !== 0) { %>
                    <%- include("relatedCategory", {
                        name: name,
                        categories: value
                    }) %>
            <% }}%>
    </div>
      <a href=<%=`games/edit/${gameID}`%> ><button><span>Edit</span></button></a>
</div>