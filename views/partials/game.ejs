<li>
    <div class="game">
        <a href=<%=`game/edit/${gameID}`%>>Edit</a>
    </div>
    <%= gameID %>, <%= gameName %>
    <div class="categories">
        <div class="categoriesView">
            <% for (const [name, value] of Object.entries(categories)){ %>
                <% if (value.length !== 0) { %>
                    <%- include("relatedCategory", {
                        name: name,
                        categories: value
                    }) %>
            <% }}%>
        </div>
</div>
</li>
