<% if (locals.item.id) {%>
    <div class="relatedGame">
        <%= item.name %><button data-id="<%= item.id %>" data-category="<%= name %>">remove</button>
    </div>
    <script>
       document.querySelector(`[data-id="<%= item.id %>"][data-category="<%= name %>"]`).addEventListener("click", async () => {
            const url = `/<%= categoryName %>/deleteRelation/`
            const response = await fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({gameId: Number('<%= gameID %>'), itemId: Number(`<%= item.id%>`) })
            })
            if (response.ok){
            document.querySelector(`[data-id="<%= item.id %>"]`).closest(".relatedGame").remove();
            }
        })
       
    </script>
<% } %>