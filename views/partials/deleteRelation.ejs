
<p id="<%= item.id %>"><%= item.name %></p><button data-id="<%= item.id %>" data-category="<%= name %>"><span>remove</span></button>
    <script>
        {
        const p = document.getElementById("<%= item.id %>");
        const removeBtn = document.querySelector(`[data-id="<%= item.id %>"][data-category="<%= name %>"]`);
        const category = removeBtn.closest(".removeRelation");
       removeBtn.addEventListener("click", async () => {
            const url = `/games/<%= categoryName %>/deleteRelation/`
            const response = await fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({gameId: Number('<%= gameID %>'), itemId: Number(`<%= item.id%>`) })
            })
            if (response.ok){
            p.remove();
            removeBtn.remove();
            if (!category.querySelector("button")) {
                category.remove()
            }
            }
        })
    }
</script>
