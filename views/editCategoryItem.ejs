<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/style.css">
    <title>Document</title>
</head>
<body>
    <%- include("partials/header") %>
    <% if (locals.item) { %>
        <div class="formContainer">
         <% if (errors.length !== 0) { %>
            <% for (const error of errors) { %>
            <p><%= error.msg %></p>
        <% }}%>
            <p><%= item.name %> </p>
            <form action="/categories/<%= categoryName %>/delete/<%= item.id %>" method="post" onsubmit="return confirm('Are you sure you want to delete this item?')"> <input type="text" name="delete" id="delete" hidden><button type="submit" class="delete"><span>Delete</span></button></form>
            <form action="/categories/<%= categoryName %>/edit/<%= item.id %>" method="post" onsubmit="return confirm('Are you sure you want to submit this form?')">
                <label for="gameName"><%= categoryName.charAt(0).toUpperCase() + categoryName.slice(1, -1) %> Name</label>
                <input type="text" name="name" id="name" value="<%= item.name %>">
                <button type="submit"><span>Change</span></button>
            </form>
        </div>
    <% } %>
    <%- include("partials/footer") %>
</body>
</html>