<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <% if (locals.game) { %>
    <button class="edit">Edit</button>
    <div class="games">
        <div class="view">
            <h1> <%= game.gameName %> </h1>
            <p> <%= game.gameDescription %> <p>
        </div>
        <div class="editForm">
            <form action="/game/edit/<%=game.gameID%>" method="post" onsubmit="return confirm('Are you sure you want to submit this form?')">
                <input name= "gameId" type="text" value="<%= game.gameID %>" hidden>
                <label for="gameName">Game Name: </label>
                <input type="text" name="gameName" id="gameName" value="<%= game.gameName %>">
                <label for="gameDescription">Game Description: </label>
                <textarea type="field" name="gameDescription" id="gameDescription"><%= game.gameDescription %>"</textarea>
                <button type="submit">Change</button>
            </form>
        </div>
    </div>
    <div class="categories">
        <div class="categoriesView">
            <% for (const category of [{name: "platforms", value: game.platforms}, {name: "genres", value: game.genres}, {name: "developers", value: game.developers}]){ %>
                <% if (category.value.length !== 0) { %>
                    <%- include("partials/relatedCategory", {
                        name: category.name,
                        categories: category.value
                    }) %>
            <% }}%>
        </div>
    </div>
    <% } %>
</body>
<script>
    const editToggler = document.querySelector(".edit");
    const view = document.querySelector(".view");
    const editForm = document.querySelector(".editForm");
    const defaultDisplay = {
        view: view.style.display,
        editForm: editForm.style.display
    }
    editForm.style.display = "none"

    editToggler.addEventListener("click", () => {
        editToggler.textContent === "Edit" ? editToggler.textContent = "Cancel" : editToggler.textContent = "Edit";
        editForm.style.display === "none"? editForm.style.display = defaultDisplay.editForm : editForm.style.display = "none"
        view.style.display !== "none"? view.style.display = "none" : view.style.display = defaultDisplay.view
    });
</script>
</html>