<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Document</title>
</head>
<body>
    <form action="/newGame" method="post">
        <label for="gameName">Game Name: </label>
        <input type="text" name="gameName" id="gameName" required>
        <label for="gameDescription">Game Description: </label>
        <textarea name="gameDescription" id="gameDescription"></textarea>
        <% for (const [name, arr] of Object.entries(categories)) { %>
            <label for="<%= name %>"> <%= name %> : </label>
            <input type="checkbox" id="<%= name %>" class="category">
            <fieldset id="<%= name %>Input" disabled>
                <%- include("partials/options",  {name: name, category: arr}) %>
            </fieldset>
        <% } %>
        <button type="submit">Submit</button>
    </form>
    <%- include("partials/toggleSelect") %>
</body>
     
</html>