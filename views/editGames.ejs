<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/style.css">
    <title>Document</title>
</head>
<body>
    <%- include("partials/header") %>
    <% if (locals.gameName) { %>
    <div class="formContainer">
         <% if (errors.length !== 0) { %>
            <% for (const error of errors) { %>
            <p><%= error.msg %></p>
        <% }}%>
        <div class="gameControl">
            <form action="/games/delete/<%= gameID %>" method="post" onsubmit="return confirm('Are you sure you want to delete this game?')"><button type="submit" class="delete"><span>Delete</span></button></form>
                <a href="/games/<%= gameName %>/<%= gameID %>/assignCategories"><button><span>Assign Category</span></button></a>
        </div>
        <form action="/games/edit/<%=gameID%>" method="post" onsubmit="return confirm('Are you sure you want to submit this form?')">
            <label for="gameName">Game Name</label>
            <input type="text" name="gameName" id="gameName" value="<%= gameName %>">
            <label for="gameDescription">Game Description</label>
            <textarea type="field" name="gameDescription" id="gameDescription" rows="5" cols="20"><%= gameDescription %></textarea>
            <button type="submit"><span>Change</span></button>
        </form>
            <% for (const [name, value] of Object.entries(categories)) { %>
                <%- include("partials/editRelatedCategory", {gameID: gameID, name: name, category: value}) %>
            <% } %>
        </div>
    </div>
    <% } %>
    <%- include("partials/footer") %>
</body>

</html>