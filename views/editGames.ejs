<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <% if (locals.gameName) { %>
    <div class="assignCategories">
        <a href="/<%= gameName %>/<%= gameID %>/assignCategories">add new category</a>
    </div>
    <div class="games">
        <div class="view">
            <h1> <%= gameName %> </h1>
            <p> <%= gameDescription %> <p>
        </div>
        <div class="editForm">
            <form action="/game/edit/<%=gameID%>" method="post" onsubmit="return confirm('Are you sure you want to submit this form?')">
                <label for="gameName">Game Name: </label>
                <input type="text" name="gameName" id="gameName" value="<%= gameName %>">
                <label for="gameDescription">Game Description: </label>
                <textarea type="field" name="gameDescription" id="gameDescription"><%= gameDescription %></textarea>
                <button type="submit">Change</button>
            </form>
        </div>
        <% for (const [name, value] of Object.entries(categories)) { %>
            <%- include("partials/editRelatedCategory", {gameID: gameID, name: name, category: value}) %>
        <% } %>
    </div>

    <% } %>
</body>

</html>